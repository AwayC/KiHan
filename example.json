// 动作配置示例 (JSONC：带注释，仅供查阅；JsonUtility 不支持注释，实际配置需去掉所有 // 注释)
// 约定：
//   - 帧数一律为 30fps 素材帧 (帧号从 0 开始)，区间为闭区间 { "x": 起始帧, "y": 结束帧 }
//     取消窗口 / 临时窗口 / 攻击阶段 / 移动接受 / 霸体：本逻辑帧处理到区间内任意一帧即生效 (取消窗口即"播完第 x~y 帧中的任一帧后可切换")
//     受击盒阶段 (defensePhase)：按当前姿态帧 (受击判定所用受击盒所在的帧) 判断；临时窗口 startFrames 为开启后处理的帧数
//   - 定点数字段一律写字符串 ("0.2")，由 ActionData.ParseFP 转换
//   - 枚举字段写名称字符串 ("Ground", "Super", "Attack")，忽略大小写
//   - 坐标轴：x 横向 (面朝方向为正), y 纵深, z 高度；距离单位为逻辑单位 (100 像素 = 1)
//   - changeType：0 = Keep (不变), 1 = ChangeToActionId (param 为动作 id), 2 = ChangeByCatalog (param 为 catalog)
//   - 通用受击动作 id 固定且必须配置：hurt_1 hurt_2 hurt_toair hurt_inair hurt_fall lie standup (最小配置见 action_template.json)
//     受击流程由框架驱动 (toair -> inair -> fall -> 触地弹起或倒地 -> lie -> standup 无敌 -> 默认动作)，受击动作无需配置 autoNext
//     攻击不配置 hurtAction 时：僵直默认 hurt_1，抓取默认 hurt_2，地面击飞默认 hurt_toair；空中受击固定 hurt_inair
//   - 受击反应按目标状态决定 (每次命中只出一种)：
//       被抓中 -> 只扣血；霸体 (armorBreak 不足) -> 只扣血；grab -> 抓取
//       目标浮空 -> 所有攻击都按 air 重设速度 (未配置用全局默认 GameConfig.DefaultAirLaunch：z 5, x 1)
//       目标在地面：配置 launch -> 击飞；否则 hitStun 僵直 + push 平推
//       目标倒地：只有 canHitLying 的攻击能命中，有 launch 则挑起，否则保持倒地只扣血
//     launch / air：z 竖直初速度, x 攻击者面朝方向前方, y 纵深 (单位/秒)，覆盖目标当前速度；水平速度在击飞流程中 (含触地弹起) 保持，弹不起倒地时清除
//     被击飞期间重力为 gravity (40) × launchGravityScale (0.7) = 28：滞空时间 = 2z / 28，最高点 = z² / 56
//     push：只在地面僵直时生效，inSec 秒内按 tweenMethod 平推 (x, y)
//   - 不配置姿态：进入条件由取消关系决定；配置 onLand 且不设置 velocityZ 的动作视为空中动作
//   - commands：触发指令，满足任意一条即可；每条由 press / hold / release 三组按键组成，组内与组间全部满足才成立
//     press   = 预输入时长 (validInSec，默认 "0.2") 内按下过，且这次按下还没被动作切换用掉 (切换动作时所有按下都会用掉：点一下只出一段，只配 press 的键按住不连发)
//               写多个键即同时按 (不分先后)：同一帧按下，或先按的键自己不出招时成立；若先按的键已出招，它的按下随动作切换用掉，
//               此时改配 { "hold": ["Skill1"], "press": ["Attack"] } 放在先出的动作开头取消窗口里，并让同时按的动作优先级更高
//     hold    = 当前按住 (按钮) 或摇杆当前处于该状态
//     release = 预输入时长内松开过 (动作切换不清除，同一个键再次按下才作废)
//     按钮：Attack Skill1 Skill2 Ultimate Substitution Secret Summon
//     摇杆 (只能写在 hold 中)：Move 任意方向 / Up 纵深向上 / Down 纵深向下 (均含斜向) / Forward / Backward (按当前朝向换算，含斜向)
//     同时满足的多个动作按优先级 (窗口 + 标签 + 动作) 选出一个，配置时避免同优先级同时满足
{
  "data": [
    // ==================== 基础：idle / move (按住摇杆持续移动，随摇杆转向) ====================
    {
      "id": "idle",
      "animKey": "Idle",
      "catalog": "Base",
      "keepPlayingAnim": true,                           // 循环播放，被自己的预约保持时不从头播
      "autoNextActionId": "idle",
      "beCancelledTag": [
        { "frameRange": { "x": 0, "y": 999 }, "cancelTag": ["move", "attack1", "skill1", "skill2"], "priority": 0 }
      ],
      "inputAcceptance": [
        { "range": { "x": 0, "y": 999 }, "rateX": "0", "rateY": "0", "turn": true }   // 站立不移动，但允许随摇杆转向
      ]
    },
    {
      "id": "move",
      "animKey": "Run",
      "catalog": "Base",
      "keepPlayingAnim": true,
      "autoTerminate": true,                             // 没有任何预约维持时转 autoNext：松开摇杆即回 idle
      "autoNextActionId": "idle",
      "cancelTag": [
        { "tag": "move", "startFormFrame": 0, "priority": 0 }
      ],
      "beCancelledTag": [
        { "frameRange": { "x": 0, "y": 999 }, "cancelTag": ["move", "attack1", "skill1", "skill2"], "priority": 0 }   // 含 move 自身：按住时每帧自我维持
      ],
      "commands": [
        { "hold": ["Move"] }                             // 摇杆当前有任意方向即满足
      ],
      "inputAcceptance": [
        { "range": { "x": 0, "y": 999 }, "rateX": "1", "rateY": "1", "turn": true }   // 全速跟随摇杆，朝向跟随摇杆左右
      ]
    },

    // ==================== 普攻：attack4 (跳起上挑，击飞) ====================
    {
      "id": "attack4",                                   // 动作唯一 id
      "animKey": "attack_4",                             // 动画名 (FrameAnimator 播放的 clip)
      "catalog": "Attack",                               // 动作类别 (ChangeByCatalog 按此查找)
      "priority": 10,                                    // 动作基础优先级 (同帧多个预约时取最高)
      "autoNextActionId": "idle",                        // 动画播完后自然流向的动作
      "cancelTag": [                                     // 本动作携带的取消标签 (能打断带对应 beCancelledTag 的动作)
        { "tag": "attack4", "startFormFrame": 0, "priority": 10 }   // startFormFrame：打断进入时从第几帧开始播
      ],
      "beCancelledTag": [                                // 允许被打断的窗口
        { "frameRange": { "x": 14, "y": 23 }, "cancelTag": ["skill1", "skill2"], "priority": 5 }   // 第 14~23 帧可被取消
      ],
      "tempBeCancelledTag": [                            // 临时取消窗口模板 (由 tempBeCancelledTagTurnOn 按 id 开启)
        { "id": "atk4_hit", "startFrames": 6, "cancelTag": ["skill"], "priority": 5 }         // startFrames：从开启时刻起持续多少帧
      ],
      "commands": [                                      // 触发指令 (任意一条满足即可)
        { "press": ["Attack"], "validInSec": "0.2" },    // 点按：0.2 秒内按下过 (窗口打开前点的也算)
        { "hold": ["Attack"] }                           // 按住：长按普攻时取消窗口一打开就接本段
      ],
      "inputAcceptance": [                               // 摇杆移动接受：rateX 横向 / rateY 纵深分别乘各自移动速度 (留空为 0)；多段重叠时各轴取最小
        { "range": { "x": 0, "y": 1 }, "rateX": "0", "rateY": "0", "turn": true },   // 第 0~1 帧：不移动，朝向跟随摇杆左右 (推左出招即朝左；正上 / 正下不改变朝向)
        { "range": { "x": 2, "y": 5 }, "rateX": "0", "rateY": "0.5" }               // 第 2~5 帧：只允许纵深走位 (50%)，横向锁定
      ],
      "rootMotion": [                                    // 根运动分段：每段按自己的帧区间生效，水平走缓动位移，竖直只走速度模型
        { "frameRange": { "x": 2, "y": 8 }, "moveX": "0.6", "tweenMethod": "Linear" },   // 第 2~8 帧前进 0.6 (moveX 面朝方向为正, moveY 纵深；多段同帧相加)
        { "frameRange": { "x": 6, "y": 6 }, "velocityZ": "6", "velocityX": "3" },      // 第 6 帧起跳：竖直速度 6；同时设置水平惯性 3 单位/秒 (面朝方向前方为正，velocityY 为纵深)
                                                                                         // 惯性与动画帧无关地持续，直到切换到其他动画 / 落地 / 撞墙 ("0" 表示清零)
        { "frameRange": { "x": 10, "y": 13 }, "accelerationZ": "30" },                   // 第 10~13 帧附加 +30 (重力 40 时净 -10，形成滞空)
        { "frameRange": { "x": 16, "y": 20 }, "moveX": "-0.2", "tweenMethod": "Slowly" } // 第 16~20 帧后撤 0.2，先快后慢
      ],
      "onLand": { "changeType": 1, "param": "idle", "priority": 10, "fromFrame": 0 },   // 落地时的动作变化 (本动作有 velocityZ 段，起跳前在地面不会触发)
      "attackPhase": [                                   // 攻击盒开启阶段
        { "frameRanges": [{ "x": 9, "y": 11 }], "tag": [], "attackPhase": 0, "priority": 10 }   // tag 为空匹配全部攻击盒；attackPhase 指向 attacks 下标
      ],
      "attacks": [                                       // 伤害段 (下标对应 attackPhase.attackPhase)
        {
          "phase": 0,                                    // 段号
          "attack": "40",                                // 伤害
          "hitStun": "0.4",                              // 地面僵直秒数 (未击飞时生效)
          "push": { "x": "0.4", "y": "0", "inSec": "0.15", "tweenMethod": "Slowly" },   // 地面僵直时的平推：x 攻击者面朝方向前方, y 纵深；tweenMethod：Linear / Slowly
          "launch": { "z": "9", "x": "2" },              // 地面击飞：配置即击飞 (此时 hitStun / push 不生效)
          "air": { "z": "5", "x": "1" },                 // 命中浮空目标时的速度 (可省略，默认 z 5, x 1)；z 为负即下砸
          "armorBreak": "None",                          // 破霸等级：None / Skill / Super / KingKong；>= 目标霸体才产生受击反应
          "canHitLying": true,                           // 能否命中倒地目标 (扫地)；有 launch 时把倒地目标挑起
          "canHitSameTarget": 1,                         // 同一目标最多命中次数
          "hitSameTargetDelay": "0",                     // 同一目标两次命中的间隔秒数
          "hurtAction": "hurt_toair",                    // 地面受击动作 (僵直 / 击飞 / 被抓)，可省略
          "tempBeCancelledTagTurnOn": ["atk4_hit"]       // 命中后为自己开启的临时取消窗口 id
        }
      ]
    },

    // ==================== 普攻派生：推上摇杆 + 普攻 ====================
    {
      "id": "attack2_up",
      "animKey": "attack_2_up",
      "catalog": "Attack",
      "priority": 20,                                    // 高于普通 attack2 (10)：推着上时两者都满足，按优先级取本动作；不推则只有 attack2 满足
      "autoNextActionId": "idle",
      "cancelTag": [
        { "tag": "attack2", "startFormFrame": 0, "priority": 0 }   // 与 attack2 共用标签：上一段放行 attack2 的窗口同样放行本动作
      ],
      "commands": [
        { "hold": ["Up"], "press": ["Attack"], "validInSec": "0.2" },   // 推着上 (含左上 / 右上) + 点普攻
        { "hold": ["Up", "Attack"] }                                     // 推着上 + 按住普攻 (长按连段时同样走派生)
      ]
    },

    // ==================== 技能派生 (技能划平 A)：技能释放中按普攻，接技能专属派生 ====================
    {
      "id": "skill1_follow",
      "animKey": "skill_A_follow",
      "catalog": "Skill",
      "priority": 20,
      "autoNextActionId": "idle",
      "cancelTag": [
        { "tag": "skill1_follow", "startFormFrame": 0, "priority": 0 }   // 专属标签：只有 skill1 开放 { "cancelTag": ["skill1_follow"] } 的窗口能进入
      ],
      "commands": [
        { "press": ["Attack"], "validInSec": "0.2" }
      ]
      // 在 skills.json 中列进 skill1 该段的 followActions：派生期间仍算释放技能，离开后才开始 CD，命中也计入该技能的查克拉
    },

    // ==================== 蓄力技能：按下进入蓄力，松开按蓄力时长释放 ====================
    {
      "id": "skill1_charge",
      "animKey": "skill_A_charge",
      "catalog": "Skill",
      "priority": 20,
      "autoNextActionId": "skill1_release_lv2",          // 蓄满 (播完) 自动重释放
      "cancelTag": [
        { "tag": "skill1", "startFormFrame": 0, "priority": 20 }
      ],
      "beCancelledTag": [
        { "frameRange": { "x": 0, "y": 14 }, "cancelTag": ["skill1_release_lv1"], "priority": 0 },   // 前 15 帧松开：轻释放
        { "frameRange": { "x": 15, "y": 999 }, "cancelTag": ["skill1_release_lv2"], "priority": 0 }  // 之后松开：重释放
      ],
      "commands": [
        { "press": ["Skill1"], "validInSec": "0.2" }
      ]
    },
    {
      "id": "skill1_release_lv1",
      "animKey": "skill_A_release",
      "catalog": "Skill",
      "priority": 20,
      "autoNextActionId": "idle",
      "cancelTag": [
        { "tag": "skill1_release_lv1", "startFormFrame": 0, "priority": 0 }
      ],
      "commands": [
        { "release": ["Skill1"], "validInSec": "0.1" }   // 松开技能1 (进入蓄力前就已松开也算：松开记录不随动作切换清除)
      ]
    },
    {
      "id": "skill1_release_lv2",
      "animKey": "skill_A_release_full",
      "catalog": "Skill",
      "priority": 20,
      "autoNextActionId": "idle",
      "cancelTag": [
        { "tag": "skill1_release_lv2", "startFormFrame": 0, "priority": 0 }
      ],
      "commands": [
        { "release": ["Skill1"], "validInSec": "0.1" }
      ]
    },

    // ==================== 技能：skill2_2 (螺旋丸：吸附 -> 抓取 -> 爆发击飞) ====================
    {
      "id": "skill2_2",
      "animKey": "skill_B",
      "catalog": "Skill",
      "priority": 20,
      "autoNextActionId": "idle",
      "cancelTag": [
        { "tag": "skill2_2", "startFormFrame": 0, "priority": 20 }
      ],
      "beCancelledTag": [
        { "frameRange": { "x": 34, "y": 39 }, "cancelTag": ["move", "attack1"], "priority": 0 }   // 后摇可被移动/普攻取消
      ],
      "commands": [
        { "hold": ["Down"], "press": ["Skill2"], "validInSec": "0.2" }   // 推着下 + 技能2
      ],
      "events": [                                        // 动作时间轴事件 (处理到该帧时触发一次，中途切入不补发)
        { "frame": 0, "type": "Effect", "asset": "Characters/naruto/effect/lxw/ball", "anchor": "lxw", "bind": true, "stopOnActionEnd": true },   // 跟随锚点的特效，动作结束即回收
        { "frame": 4, "type": "Spawn", "spawnId": "naruto_skill2_fx", "anchor": "", "offset": { "x": 0, "y": 0 } },   // 生成物 (spawns.json)，位置 = 锚点 + 像素偏移
        { "frame": 6, "type": "Camera", "asset": "impact_heavy" },   // 镜头效果：impact / impact_heavy
        { "frame": 6, "type": "Buff", "asset": "rage" }              // 给自己添加一层 Buff (buffs.json)
      ],
      "armorPhase": [                                    // 霸体区间
        { "range": { "x": 0, "y": 30 }, "level": "Super" },   // 等级：None / Skill / Super / KingKong / Invincible
        { "range": { "x": 31, "y": 39 }, "level": "Skill" }   // 后摇降为技能体
      ],
      "rootMotion": [
        { "frameRange": { "x": 0, "y": 8 }, "moveX": "1.2" }   // 第 0~8 帧匀速突进 1.2 (tweenMethod 留空为 Linear)
      ],
      "attackPhase": [
        { "frameRanges": [{ "x": 6, "y": 14 }], "tag": [], "attackPhase": 0, "priority": 10 },    // 吸附多段
        { "frameRanges": [{ "x": 16, "y": 17 }], "tag": [], "attackPhase": 1, "priority": 20 },   // 抓取
        { "frameRanges": [{ "x": 32, "y": 33 }], "tag": [], "attackPhase": 2, "priority": 30 }    // 爆发 (grab 锚点画到第 31 帧，第 32 帧消失即释放，同帧爆发正常击飞)
      ],
      "attacks": [
        {
          "phase": 0,                                    // 第一段：吸附
          "attack": "8",
          "hitStun": "0.3",
          "armorBreak": "Skill",
          "suction": {                                   // 吸附：把目标水平拉向攻击者身前核心点
            "centerX": "0.8",                            // 核心点本地偏移 x (面朝方向前方)
            "centerY": "0",                              // 核心点本地偏移 y (纵深)
            "speed": "4",                                // 拉扯速度 (单位/秒)，不会越过核心点
            "inSec": "0.3"                               // 持续秒数
          },
          "canHitSameTarget": 3,                         // 最多命中 3 次
          "hitSameTargetDelay": "0.1",                   // 每 0.1 秒一次
          "hurtAction": "hurt_1"
        },
        {
          "phase": 1,                                    // 第二段：抓取 (被抓期间任何命中只扣血、保持抓取，可在此期间打多段)
          "attack": "10",
          "armorBreak": "Super",
          "grab": {                                      // 抓取：目标逐帧锁定在攻击者帧锚点上，不受重力与外力影响
            "enabled": true,
            "anchor": "grab",                            // 帧库 EffectAnchors 中的锚点名 (可省略，默认 "grab")；帧上有锚点 = 保持抓取，锚点消失 = 释放
            "releaseActionChange": { "changeType": 1, "param": "hurt_fall", "priority": 100 }   // 锚点消失释放 (主动松手/被打断/播完) 时目标的动作
          },
          "canHitSameTarget": 1,
          "hurtAction": "hurt_2"                         // 被抓期间循环播放 (可省略，默认 hurt_2)
        },
        {
          "phase": 2,                                    // 第三段：爆发击飞
          "attack": "120",
          "launch": { "z": "7", "x": "6" },              // 地面目标：竖直 7，向前 6 单位/秒飞出
          "air": { "z": "10", "x": "6" },                // 释放瞬间目标若在空中 (锚点 y > 0)，竖直改用 10
          "armorBreak": "Super",
          "canHitSameTarget": 1
        }
      ]
    }
  ]
}
