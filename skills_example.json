// 技能配置示例 (带注释，仅供查阅；实际配置放在 Resources/Characters/<角色>/skills.json，去掉注释)
// 对应 DTO：SkillDataContainer / SkillData (Assets/Scripts/Game/Character/Skill/SkillInfo.cs)
// 时间一律写字符串秒数 (String-First，运行时换算为逻辑帧，不足一帧按一帧计)
{
  "chakraMax": 4,                                        // 查克拉上限 (颗)，<= 0 或省略时取默认 4
  "data": [
    // ==================== 单段技能 ====================
    {
      "id": "skill1",                                    // 技能唯一 id
      "button": "Skill1",                                // UI 显示所在的按键：Skill1 / Skill2 / Ultimate / Substitution / Secret / Summon
                                                         // 只决定 CD / 图标显示在哪个键上，出招指令仍由入口动作 (actions.json) 的 commands 决定
      "icon": "UI/SkillButton/90001_SkillIconAtlas#90001_SkillIconAtlas_0",   // 按键图标：Resources 路径；多图切片贴图写 "路径#子图名"
      "cooldown": "8",                                   // CD 秒数：进入入口动作即开始计算完整 CD
      "chakraCost": 0,                                   // 进入入口动作时消耗的查克拉颗数 (奥义等)，不足时无法释放
      "actionId": "skill1"                               // 入口动作：由输入发起，受技能准入裁决 (CD / 换段 / 查克拉 / 受击条件)
                                                         // 技能派生 (如 skill1_follow，见 example.json) 不需要登记：派生 / autoNext / 落地 / goto 进入的动作自动沿用正在释放的技能
    },

    // ==================== 带命中派生的技能 ====================
    {
      "id": "skill2",
      "button": "Skill2",
      "icon": "UI/SkillButton/90001_SkillIconAtlas#90001_SkillIconAtlas_1",
      "cooldown": "10",
      "actionId": "skill2_1"                             // 命中派生写在动作的 scripts 中 (hit 记变量 + frame cond goto，见 example.json 的 multi_1)
                                                         // 后续动作及其生成物命中时也按本技能获得查克拉
    },

    // ==================== 多段技能 (按键换段) ====================
    {
      "id": "multi",
      "button": "Skill2",
      "icon": "UI/SkillButton/xxx#xxx_0",                // 技能图标：换段未配置图标时使用
      "cooldown": "12",
      "actionId": "multi_1"                              // 第 1 段入口；后续段由动作指令 skillStage 换上按键：
                                                         //   multi_1 frame 0: { "op": "skillStage", "skill": "multi", "action": "multi_2", "window": "2", "cdReturn": "4", "icon": "UI/SkillButton/xxx#xxx_1" }
                                                         //   multi_2 frame 0: { "op": "skillStage", "skill": "multi", "action": "multi_3", "window": "1.5", "cdReturn": "2", "icon": "UI/SkillButton/xxx#xxx_2" }
                                                         // window 秒内可按键接下一段 (换段期间 CD 清零、入口动作被拦截)；超时开始 CD = 12 - cdReturn；
                                                         // 进入下一段动作时恢复按键并开始完整 CD (multi_3 无 skillStage，即最后一段)
                                                         // 下一段动作不能同时是任何技能的 actionId
    },

    // ==================== 替身术 ====================
    {
      "id": "substitution",
      "button": "Substitution",
      "cooldown": "10",
      "requireHurt": true,                               // 只能在受击状态 (僵直 / 击飞 / 被抓 / 倒地) 下释放；起身中已无敌，不可使用
      "actionId": "substitution"                         // 入口动作需在 actions.json 中配置 "breakHurt": true (受控锁定时也检测指令，进入后解除受击并起身无敌)
    }
  ]
}

// 查克拉规则：技能刷新 (CD 结束) 后可获得一次。该技能任一动作 (入口、换段、派生) 或其生成物命中时 +1 (上限 chakraMax)，之后要等下次刷新才能再获得。
// 开局所有技能就绪、可获得查克拉，查克拉为 0。普攻等不属于任何技能的动作命中不获得查克拉。
